# ─────────────────────────────────────────────────────────────────
#  Careem AI Talent Advisor — Environment Configuration
# ─────────────────────────────────────────────────────────────────
#  Copy this file to .env and fill in your actual API keys.
#  Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Mistral AI (Recommended — Best quality with Mistral Large) ──
# Get your key at: https://console.mistral.ai/keys
MISTRAL_API_KEY=your_mistral_api_key_here

# ── Groq (Fast alternative with Llama 3.3 70B) ──
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ── LLM Provider Selection ──
# Options: 'mistral' (default, best quality) or 'groq' (faster)
LLM_PROVIDER=mistral

# ── LLM Model ──
# Mistral: mistral-large-latest (recommended), mistral-small-latest
# Groq:    llama-3.3-70b-versatile
LLM_MODEL=mistral-large-latest

# ── Server Port ──
PORT=8000
