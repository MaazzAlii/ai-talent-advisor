# Careem AI Talent Advisor - Environment Variables Example
# Copy this file to ".env" and fill in your real keys. Never commit the real ".env" file.

# --- API Keys ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Get a key at https://console.mistral.ai/api-keys
# Note: MISTRAL_API_KEY is also used for OCR'ing PDF/PNG/JPG resumes via Mistral's OCR API,
# regardless of which provider is active below, so set it even if LLM_PROVIDER=groq.
MISTRAL_API_KEY=your_mistral_api_key_here

# --- LLM Configuration ---
# Provider used for resume scoring + interview questions + feedback: "groq" or "mistral"
LLM_PROVIDER=groq
# Text-scoring model for the active provider. Leave as-is unless you know what you're changing to.
# groq default:    openai/gpt-oss-120b
# mistral default: mistral-large-latest
LLM_MODEL=openai/gpt-oss-120b

# --- Application Config ---
PORT=8000
